<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <!-- Produces a .deps.json and copies dependencies next to the plugin DLL
         so the host's AssemblyDependencyResolver can locate them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin icon, read from the assembly so it does not depend on the install layout. -->
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.Bluetooth.icon.png" Condition="Exists('icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host at runtime: compile against it but do
         not copy it into the plugin folder. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.31.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- The plugin talks to BlueZ over D-Bus. Same library and version as the other
         Linux plugins in this workspace. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host reads these straight off disk next to plugin.json, so they have to be copied
         like any other content file. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
