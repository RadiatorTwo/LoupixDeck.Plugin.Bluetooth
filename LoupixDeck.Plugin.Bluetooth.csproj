<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Windows TFM brings the WinRT projection (Windows.Devices.*) for the Windows backend.
         The assembly still loads on Linux: the projection is plain managed code that only the
         Windows backend touches. EnableWindowsTargeting lets the Linux release CI build it. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>
    <!-- The Windows backend calls Core Audio and kernel streaming COM interfaces through raw vtables. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Produces a .deps.json and copies dependencies next to the plugin DLL
         so the host's AssemblyDependencyResolver can locate them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin icon, read from the assembly so it does not depend on the install layout. -->
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.Bluetooth.icon.png" Condition="Exists('icon.png')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host at runtime: compile against it but do
         not copy it into the plugin folder. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.31.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>

    <!-- The plugin talks to BlueZ over D-Bus. Same library and version as the other
         Linux plugins in this workspace. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host reads these straight off disk next to plugin.json, so they have to be copied
         like any other content file. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
